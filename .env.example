# Copy this file to .env next to your docker-compose.yml and fill in the values.
# Do not commit real credentials.

# Authentication
AUTH_MODE=cloudflare
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=your-cloudflare-access-aud-tag

# Taskwarrior profile/user config mounted into the container.
PROFILES_CONFIG=/profiles.json
USERS_CONFIG=/users.json

# Single-profile fallback when PROFILES_CONFIG is not mounted.
TASKRC=/.taskrc
TASKDATA=/.task

# Local/dev auth fallback. Only used when AUTH_MODE=dev.
DEV_USER_EMAIL=dev@localhost

# CalDAV task alerts. Taskwarrior remains the source of truth; this mirrors
# timed scheduled/due tasks into a calendar as VEVENT + VALARM.
CALDAV_ENABLED=false
CALDAV_BASE_URL=https://radicale.example.com/user/calendar/
CALDAV_USERNAME=
CALDAV_PASSWORD=
CALDAV_ALARM_TRIGGER=-PT10M
CALDAV_EVENT_DURATION_MINUTES=15
CALDAV_TIMEZONE=Europe/Madrid
CALDAV_REQUEST_TIMEOUT_MS=5000
